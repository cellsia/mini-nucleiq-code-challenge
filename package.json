{
  "name": "mini-nucleiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "architecture": "depcruise --config .dependency-cruiser.cjs src",
    "check": "bun run typecheck && bun run lint && bun run architecture && bun run test:coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "dependency-cruiser": "18.1.0",
    "typescript": "6"
  }
}
